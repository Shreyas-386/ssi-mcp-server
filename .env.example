# Copy to .env and fill in for local development:  cp .env.example .env
# .env is git-ignored; never commit real credentials.

# --- Environment ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Downstream SSi REST API ---------------------------------------------
SSI_API_BASE_URL=https://dailygraphs.finsoftai.com
# Downstream service credential. If left empty, no Authorization header is
# sent to the SSi API at all (correct only if the downstream requires none).
SSI_API_KEY=
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=2

# --- MCP client authentication -------------------------------------------
# Shared-secret bearer token that MCP clients and ChatGPT Custom Actions must
# present over the HTTP transport. Required whenever REQUIRE_CLIENT_AUTH=true.
MCP_AUTH_TOKEN=
# Set false only for local stdio development.
REQUIRE_CLIENT_AUTH=true

# --- Transport / hosting --------------------------------------------------
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080
